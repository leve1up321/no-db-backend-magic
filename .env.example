# Ziina Payment Gateway Configuration
# احصل على مفاتيح API من: https://dashboard.ziina.com/
ZIINA_SECRET_KEY=sk_test_your_secret_key_here

# Ziina Webhook Secret (optional but recommended)
# احصل عليه من Ziina Dashboard عند إنشاء webhook
ZIINA_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Base URL for your application
# في التطوير (Development):
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# في الإنتاج (Production - Vercel):
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

