# ========================================
# Ziina Payment Gateway Configuration
# ========================================
# احصل على مفاتيح API من: https://dashboard.ziina.com/
ZIINA_SECRET_KEY=sk_test_your_secret_key_here

# Ziina Webhook Secret (مطلوب للتحقق الأمني)
# احصل عليه من Ziina Dashboard عند إنشاء webhook
ZIINA_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ========================================
# Discord Notifications
# ========================================
# رابط webhook من Discord لإرسال إشعارات الدفع
# كيفية الحصول عليه:
# 1. اذهب لسيرفر Discord
# 2. Server Settings → Integrations → Webhooks
# 3. Create Webhook
# 4. انسخ الرابط
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL

# ========================================
# Vercel Blob Storage
# ========================================
# يتم توليده تلقائياً من Vercel عند تفعيل Blob Storage
# Vercel Dashboard → Storage → Blob → Connect
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx

# ========================================
# Application URLs
# ========================================
# في التطوير (Development):
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# في الإنتاج (Production - Vercel):
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ========================================
# Email Service (اختياري - للمستقبل)
# ========================================
# إذا كنت تريد إرسال بريد إلكتروني للعميل
# يمكنك استخدام SendGrid, Resend, أو أي خدمة أخرى

# SendGrid:
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
# FROM_EMAIL=noreply@yourdomain.com

# Resend:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# FROM_EMAIL=noreply@yourdomain.com

